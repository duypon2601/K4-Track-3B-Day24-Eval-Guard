# Required: một trong hai key. Có GEMINI_API_KEY thì lab chạy bằng Gemini
# (endpoint tương thích OpenAI); nếu không thì dùng OPENAI_API_KEY.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: model và giới hạn request/phút (0 = không giới hạn)
LLM_MODEL=
LLM_RPM=

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=

# Optional: model riêng cho evaluator RAGAS (mặc định = LLM_MODEL)
EVALUATOR_MODEL=
